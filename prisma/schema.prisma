// Prisma schema for the Portify platform.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  PLATFORM_ADMIN
}

// Login account. A STUDENT account always owns exactly one Student profile.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      Student?

  @@map("users")
}

// The public, editable Portify that lives at Portify.com/<slug>.
model Student {
  id       String @id @default(cuid())
  slug     String @unique
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Header (visible first: photo, nombre, carrera, reseña)
  fullName  String?
  career    String?
  headline  String?
  photoUrl  String?

  // Contact
  contactEmail String?
  phone        String?
  linkedinUrl  String?
  githubUrl    String?
  websiteUrl   String?

  // CV template chosen by the student (extra point requirement)
  cvTemplate String @default("classic")

  // Publication state: the relational tables below are always the "draft".
  // Publishing copies their current shape into `publishedSnapshot`, which is
  // the only thing visitors, the CV PDF, and the vCard ever read from.
  publishedSnapshot Json?
  publishedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educations   Education[]
  experiences  Experience[]
  projects     Project[]
  skills       Skill[]
  achievements Achievement[]

  @@map("students")
}

model Education {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution String
  degree      String?
  fieldOfStudy String?
  startDate   String?
  endDate     String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("educations")
}

model Experience {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company     String
  role        String
  startDate   String?
  endDate     String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("experiences")
}

// Both portfolio projects and CV "proyectos académicos" — tagged with isAcademic.
model Project {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name        String
  description String?
  techStack   String?
  role        String?
  url         String?
  isAcademic  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("projects")
}

model Skill {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  category  String   @default("Técnicas")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("skills")
}

model Achievement {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("achievements")
}
